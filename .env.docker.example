# Docker 部署設定：複製成 .env.docker 再修改（cp .env.docker.example .env.docker）。
# 這個檔只在 docker compose 啟動時讀取，不會被打包進映像；.env.docker 不要傳到 GitHub。

# ── 對外埠號 ──
# 瀏覽器連 http://<電腦IP>:這個埠。80 被占用（例如 IIS、Skype）就改 8080。
ERP_HTTP_PORT=80

# ── 映像來源（選用）──
# 不設：從原始碼自己建置（docker compose up -d --build）。
# 設成 GitHub 上的映像：可直接 docker compose pull，不用建置。
# ERP_BACKEND_IMAGE=ghcr.io/ewiwi22255/docker-project-test-backend:latest
# ERP_WEB_IMAGE=ghcr.io/ewiwi22255/docker-project-test-web:latest

# ── 示範模式 ──
# true：自動建立示範帳號（admin/admin、wh1/wh1、sales1/sales1、hr1/hr1…）與示範資料。
# 只適合內網測試或比賽展示；放到公開網路前務必改成 false 並建立正式帳號。
ERP_DEMO_MODE=true
# Agent Dashboard 的合成採購單等示範紀錄（選用）
ERP_ENABLE_DEMO_SEED=false

# ── 登入權杖 ──
# 簽章金鑰：留空會自動產生並存在資料庫 volume 裡（重啟後仍有效）。
# ERP_API_SECRET=
# 登入有效秒數，預設 28800（8 小時）
# ERP_API_TOKEN_TTL=28800

# ── AI 模型（客戶 AI 分析、舊版 AI 助理）──
# 可從專案原本的 .env 複製 LLM_* 與金鑰過來；不填則 AI 按鈕會顯示「暫時無法產生」。
# LLM_MODEL=openai/deepseek-v4-flash
# LLM_FALLBACK_MODELS=
# OPENAI_API_BASE=https://opencode.ai/zen/go/v1
# OPENAI_API_KEY=
# LLM_EXTRA_HEADERS={"x-opencode-session": "erp-inventory"}
# GEMINI_API_KEY=

# ── 背景排程與 LINE：測試機預設關閉 ──
ERP_SCHEDULER_ENABLED=0
LINE_BRIEFING_ENABLED=false
